# Document reader settings for /api/extract. Set the same variables in Vercel
# (Project Settings > Environment Variables) for Production and Preview.
# The endpoint must accept OpenAI-compatible chat completions with JSON schema output.
EXTRACTION_API_KEY=
EXTRACTION_API_URL=
# Comma-separated; tried in order, the next takes over when one is busy or fails.
EXTRACTION_TEXT_MODELS=
# Model that reads images and scanned pages.
EXTRACTION_VISION_MODEL=
# Optional, per model: model-a:low,model-b:none
EXTRACTION_REASONING=
